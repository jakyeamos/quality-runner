  "release_boundary": {
    "tracked_content": {
      "include_globs": [
        "README.md",
        "docs/*.md",
        "quality_runner/*.py",
        "quality_evidence_contract/*.py",
        "repo_quality_certifier/*.py"
      ],
      "local_only_globs": [".agents/context/archives/qr-rollout-20260702.md"],
      "forbidden_patterns": [
        {
          "id": "personal-home-path",
          "pattern": "/(?:Users|home)/[A-Za-z0-9._-]+/"
        },
        {
          "id": "private-operator-inventory",
          "pattern": "(?:Documents/pronto|projects/(?:Leverage|mac-control)(?:/|\\b)|\\.local/state/quality-runner/fleet)"
        }
      ]
    },
    "artifacts": {
      "wheel": {
        "allow_prefixes": [
          "quality_runner/",
          "quality_evidence_contract/",
          "repo_quality_certifier/"
        ],
        "allow_globs": ["quality_runner-*.dist-info/*"]
      },
      "sdist": {
        "allow_paths": [
          "LICENSE",
          "MANIFEST.in",
          "PKG-INFO",
          "README.md",
          "pyproject.toml",
          "setup.cfg"
        ],
        "allow_prefixes": [
          "quality_runner/",
          "quality_evidence_contract/",
          "repo_quality_certifier/",
          "quality_runner.egg-info/",
          "fixtures/contracts/public-adapters/"
        ]
      }
