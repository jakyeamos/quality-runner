{
  "version": 1,
  "hookTimeoutSeconds": 360,
  "testCommand": "uv run --locked python scripts/run_pytest_with_lcov.py --changed-only --ignore tests/test_entrypoints.py",
  "coveragePaths": [
    ".pre-cr/coverage.lcov"
  ],
  "coverageFormat": "lcov",
  "qualityCommands": [
    "uv run --locked pytest -q",
    "uv run --locked ruff check .",
    "uv run --locked ruff format --check .",
    "uv run --locked basedpyright",
    "uv run --locked vulture quality_runner quality_evidence_contract repo_quality_certifier tests scripts --min-confidence 70",
    "uv run --locked pip-audit",
    "uv build",
    "python3 scripts/check_environment_contract.py"
  ],
  "qualityAdapters": [
    {
      "name": "environment-contract",
      "command": "python3 scripts/check_environment_contract.py",
      "required": true
    }
  ],
  "threshold": 80,
  "excludePatterns": [
    ".github/**",
    ".gitignore",
    ".pre-cr.json",
    ".quality-runner/**",
    ".venv/**",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/**",
    "fixtures/**",
    "LICENSE",
    "packaging/**",
    "README.md",
    "SECURITY.md",
    "pyproject.toml",
    "quality_runner/schemas/**",
    "scripts/**",
    "tests/**"
  ],
  "checks": {
    "coverage": false,
    "security": false,
    "checklist": false
  }
}
