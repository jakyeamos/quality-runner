{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-runner.dev/schemas/onboarding-check.schema.json",
  "title": "Quality Runner repository onboarding check",
  "type": "object",
  "required": [
    "schema",
    "status",
    "readiness",
    "generated_at",
    "producer",
    "repository",
    "matrix",
    "evidence",
    "checks",
    "surfaces",
    "blocking_check_ids",
    "blocking_surface_ids"
  ],
  "properties": {
    "schema": {"const": "quality-runner-onboarding-check/v1"},
    "status": {"enum": ["passed", "blocked"]},
    "readiness": {"enum": ["ready", "not_ready"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "repository": {
      "type": "object",
      "required": ["id", "path", "branch", "head_sha", "dirty_path_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "branch": {"type": ["string", "null"]},
        "head_sha": {"type": ["string", "null"]},
        "dirty_path_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "matrix": {"$ref": "#/$defs/artifact"},
    "evidence": {"$ref": "#/$defs/artifact"},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}},
    "blocking_check_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "blocking_surface_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "output_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "producer": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "violation": {
      "type": "object",
      "required": ["rule", "path"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "path": {"type": "string"}
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["id", "status", "violations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "blocked"]},
        "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}}
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["id", "kind", "status", "evidence_status", "violations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["required", "conditional"]},
        "status": {"enum": ["passed", "blocked"]},
        "evidence_status": {
          "enum": ["passed", "failed", "blocked", "unknown", "not_applicable", "missing"]
        },
        "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}}
      },
      "additionalProperties": false
    }
  }
}
