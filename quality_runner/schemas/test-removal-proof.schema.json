{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-runner.dev/schemas/test-removal-proof.schema.json",
  "title": "Quality Runner Test Removal Proof",
  "type": "object",
  "required": ["schema", "status", "implementation_allowed", "portfolio_audit_hash", "removed_test_ids", "checks", "blockers", "input_hash", "proof_hash", "authority"],
  "properties": {
    "schema": {"const": "quality-runner-test-removal-proof/v1"},
    "status": {"enum": ["passed", "blocked"]},
    "implementation_allowed": {"const": false},
    "portfolio_audit_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "removed_test_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed", "evidence"],
        "properties": {"id": {"type": "string"}, "passed": {"type": "boolean"}, "evidence": {"type": "string"}}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proof_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"type": "object"}
  },
  "additionalProperties": true
}
